VIRUSTOTAL_API_KEY=5040c599c610225fd57a2f64c35efa79fdd76a81c470a79dc10c4e3a2eac80fe

# Google Safe Browsing API key (free: https://developers.google.com/safe-browsing)
# Leave blank to use local PhishTank feed only
GSB_API_KEY=AIzaSyBE4ZwrwCmXQV65tXQbpSmxXLerM3JehXQ

# PhishTank application key (free: register at https://www.phishtank.com/api_register.php)

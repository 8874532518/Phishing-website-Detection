# PhishGuard AI — Environment Variables
# Copy this file to .env and fill in your API keys.
# Never commit .env to Git!

# VirusTotal API key (free: sign up at https://www.virustotal.com/gui/join-us)
# Leave blank to disable VirusTotal checks
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API key (free: https://developers.google.com/safe-browsing)
# Leave blank to disable GSB checks
GSB_API_KEY=

# URLhaus Auth-Key for the malware-URL intelligence endpoint.
# Leave blank to report URLhaus as not configured.
URLHAUS_AUTH_KEY=

# PhishTank application key (free: register at https://www.phishtank.com/api_register.php)
# Leave blank to use offline CSV feed only
PHISHTANK_API_KEY=

# Set to "true" to enable live URL redirect following (disabled by default for safety)
ENABLE_REDIRECT_CHECKER=false

# Set to "true" to display detailed debug info in the UI
DEBUG_MODE=false

# Comma-separated browser origins allowed to call the API.
# Add the exact Netlify URL in the Render environment settings.
PHISHGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# This is informational; the checkbox in the frontend is the per-scan consent.
PHISHGUARD_EXTERNAL_CHECKS_ENABLED=false
